<?xml version="1.0" encoding="UTF-8"?>

<!--
    Login.fxml
    Modern, Responsive Kiosk Login Screen
    Redesigned to match the Administrator Dashboard aesthetic
    Linked to controller.LoginController
-->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <!-- Background Decoration -->
    <Region style="-fx-background-color: #1a252f; -fx-max-height: 300;" StackPane.alignment="TOP_CENTER" />

    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="450.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 30, 0, 0, 15);">

        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #1a252f; -fx-padding: 40; -fx-background-radius: 15 15 0 0;">
            <Text fill="WHITE" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-letter-spacing: 2px;" text="SYSTEM ACCESS" />
            <Text fill="#bdc3c7" style="-fx-font-size: 13; -fx-font-style: italic;" text="Authorized Personnel &amp; Customers" />
        </VBox>

        <!-- Form Content -->
        <VBox spacing="25.0" style="-fx-padding: 40;">

            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13;" text="Username" />
                <TextField fx:id="usernameField" promptText="Enter your credentials"
                           style="-fx-pref-height: 45; -fx-font-size: 14; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-background-color: #fcfdfe; -fx-padding: 0 15 0 15;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13;" text="Password" />
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-pref-height: 45; -fx-font-size: 14; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-background-color: #fcfdfe; -fx-padding: 0 15 0 15;" />

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink onAction="#handleRegisterRedirect" style="-fx-text-fill: #3498db; -fx-underline: false; -fx-font-size: 12;" text="Forgot Password?" />
                </HBox>
            </VBox>

            <!-- Action Area -->
            <VBox alignment="CENTER" spacing="15">
                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 50; -fx-font-size: 15; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="SECURE LOGIN" />

                <Label fx:id="errorLabel" style="-fx-font-size: 12;" text="" textFill="#e74c3c" wrapText="true" />
            </VBox>

            <!-- Footer Divider -->
            <Separator prefWidth="200.0" style="-fx-opacity: 0.5;">
                <VBox.margin>
                    <Insets top="10" bottom="10" />
                </VBox.margin>
            </Separator>

            <VBox alignment="CENTER" spacing="5">
                <Text fill="#95a5a6" style="-fx-font-size: 11;" text="© 2024 Kiosk Management Systems" />
                <HBox alignment="CENTER" spacing="5">
                   <!-- Circle now has the correct import above -->
                   <Circle radius="3" fill="#2ecc71" />
                   <Text fill="#bdc3c7" style="-fx-font-size: 10;" text="Server Online" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>