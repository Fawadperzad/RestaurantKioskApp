<?xml version="1.0" encoding="UTF-8"?>

<!--
    Admin Dashboard: Focused on System Administration.
    Features: User Management, Inventory Management, and Restaurant-specific Product Filtering.
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx"
 xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AdminController">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1a252f; -fx-padding: 15;">
            <VBox>
                <Text fill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;" text="ADMINISTRATOR DASHBOARD" />
                <Text fill="#bdc3c7" style="-fx-font-size: 12;" text="System &amp; Inventory Management" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;" text="Sign Out" />
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <!-- User Management Tab -->
            <Tab text="User Management">
                <HBox spacing="15" style="-fx-padding: 15;">
                    <!-- Table Section -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="System Users Registry" />
                        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="70" text="ID" />
                                <TableColumn fx:id="colUserName" prefWidth="180" text="Username" />
                                <TableColumn fx:id="colUserPassword" prefWidth="150" text="Password" />
                                <TableColumn fx:id="colUserRole" prefWidth="120" text="Account Role" />
                                <TableColumn fx:id="colUserBalance" prefWidth="150" text="Balance ($)" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button onAction="#handleEditUser" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Edit Selected User" />
                            <Button onAction="#handleDeleteUser" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Delete Selected User" />
                        </HBox>
                    </VBox>

                    <VBox prefWidth="340.0" spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="User Details" />
                        <Separator />
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Username" />
                            <TextField fx:id="newUserName" promptText="Enter username" style="-fx-pref-height: 35;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Password" />
                            <PasswordField fx:id="newUserPassword" promptText="Enter password" style="-fx-pref-height: 35;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Assign Role" />
                            <ComboBox fx:id="newUserRole" maxWidth="Infinity" promptText="Select Role" style="-fx-pref-height: 35;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="User" />
                                        <String fx:value="Manager" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Initial Deposit ($)" />
                            <TextField fx:id="amountToChange" promptText="0.00" style="-fx-pref-height: 35;" />
                        </VBox>
                        <Region prefHeight="10" />
                        <Button maxWidth="Infinity" onAction="#handleCreateUser" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 45; -fx-cursor: hand;" text="SAVE USER" />
                    </VBox>
                </HBox>
            </Tab>

            <!-- Inventory Management Tab -->
            <Tab text="Inventory Management">
                <HBox spacing="15" style="-fx-padding: 15;">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Manage Product Inventory" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 5 10; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;">
                                <Label text="🔍" />
                                <TextField fx:id="productSearchField" promptText="Search products..." style="-fx-background-color: transparent; -fx-pref-width: 200;" />
                            </HBox>
                        </HBox>

                        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProdId" prefWidth="70" text="ID" />
                                <TableColumn fx:id="colProdName" prefWidth="250" text="Product Name" />
                                <TableColumn fx:id="colProdPrice" prefWidth="100" text="Price ($)" />
                                <TableColumn fx:id="colProdRestaurant" prefWidth="150" text="Restaurant" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button onAction="#handleEditProduct" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Edit Product" />
                            <Button onAction="#handleDeleteProduct" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Remove Product" />
                        </HBox>
                    </VBox>

                    <VBox prefWidth="340.0" spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Product Details" />
                        <Separator />
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Product Name" />
                            <TextField fx:id="newProductName" promptText="e.g. Espresso" style="-fx-pref-height: 35;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Unit Price ($)" />
                            <TextField fx:id="newProductPrice" promptText="e.g. 4.50" style="-fx-pref-height: 35;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Assign to Restaurant" />
                            <ComboBox fx:id="productRestaurantChoice" maxWidth="Infinity" promptText="Select Restaurant" style="-fx-pref-height: 35;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Restaurant 1" />
                                        <String fx:value="Restaurant 2" />
                                        <String fx:value="Restaurant 3" />
                                        <String fx:value="Restaurant 4" />
                                        <String fx:value="Restaurant 5" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>
                        <Region prefHeight="10" />
                        <Button maxWidth="Infinity" onAction="#handleCreateProduct" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 45; -fx-cursor: hand;" text="SAVE PRODUCT" />
                    </VBox>
                </HBox>
            </Tab>

            <!-- Product List View Tab: FIXED Filtering -->
            <Tab text="Product List">
                <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f0f2f5;">
                    <!-- Filter Header -->
                    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);">
                        <VBox spacing="5">
                            <Label text="Filter by Restaurant" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                            <!-- Action handleFilterByRestaurant triggers the controller to update the publicProductListView -->
                            <ComboBox fx:id="viewRestaurantFilter" onAction="#handleFilterByRestaurant" prefWidth="250" promptText="Select Restaurant to view items" style="-fx-pref-height: 35;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Restaurants" />
                                        <String fx:value="Restaurant 1" />
                                        <String fx:value="Restaurant 2" />
                                        <String fx:value="Restaurant 3" />
                                        <String fx:value="Restaurant 4" />
                                        <String fx:value="Restaurant 5" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <Label text="Inventory Summary" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d; -fx-text-transform: uppercase;" />
                            <HBox spacing="5" alignment="BASELINE_LEFT">
                                <Text fx:id="filteredProductCountText" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #2980b9;" />
                                <Text text="Products found" style="-fx-font-size: 14; -fx-fill: #34495e;" />
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="🔄 Refresh Catalog" onAction="#handleRefreshProducts" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Catalog Content -->
                    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Product Catalog Results" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Showing live inventory" style="-fx-font-size: 11; -fx-text-fill: #2ecc71;" />
                        </HBox>
                        <Separator style="-fx-padding: 10 0;" />
                        <ListView fx:id="publicProductListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background-insets: 0;" />
                    </VBox>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</AnchorPane>