<?xml version="1.0" encoding="UTF-8"?>

<!--
    User Dashboard: Updated with Restaurant Filtering and Shopping Cart Logic.
    Features: Filter by Restaurant, Add to Cart functionality, and Balance-based checkout.
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UserController">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- Header: Matching Admin Dashboard Style -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1a252f; -fx-padding: 15;">
            <VBox>
                <Text fx:id="welcomeText" fill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;" text="CUSTOMER DASHBOARD" />
                <Label fx:id="welcomeLabel" text="Welcome, Guest!" textFill="#bdc3c7" style="-fx-font-size: 12px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <!-- Balance Display Area -->
            <VBox alignment="CENTER_RIGHT" spacing="2" style="-fx-background-color: rgba(255,255,255,0.1); -fx-padding: 5 15; -fx-background-radius: 5;">
                <Label text="AVAILABLE BALANCE" textFill="#bdc3c7" style="-fx-font-size: 10px; -fx-font-weight: bold;" />
                <Label fx:id="balanceLabel" text="0.00 $" textFill="#2ecc71" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            </VBox>

            <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;" text="Sign Out" />
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <!-- Order / Menu Tab -->
                <Tab text="Place New Order">
                    <HBox spacing="15" style="-fx-padding: 15;">

                        <!-- Dynamic Menu Section (Left) -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Available Menu Items" />

                                <!-- NEW: Restaurant Choice Box -->
                                <Label text="Filter by Restaurant:" style="-fx-padding: 0 0 0 20;" />
                                <ChoiceBox fx:id="restaurantFilter" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 5;" />

                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleRefreshMenu" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 5 12;" text="🔄 Refresh" />
                            </HBox>

                            <!-- Product Table with Add to Cart Functionality -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                                <TableView fx:id="menuTable" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colItemName" prefWidth="250" text="Item Name" />
                                        <TableColumn fx:id="colItemPrice" prefWidth="100" text="Price ($)" />
                                        <TableColumn fx:id="colItemRestaurant" prefWidth="150" text="Restaurant" />
                                    </columns>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                                    <Button onAction="#handleAddToCart" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;" text="➕ Add to Cart" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Shopping Cart Section (Right) -->
                        <VBox prefWidth="380.0" spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Your Shopping Cart" />
                            <Separator />

                            <!-- List of items added to cart -->
                            <ListView fx:id="cartList" style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 5;" VBox.vgrow="ALWAYS" />

                            <VBox spacing="10" style="-fx-padding: 10 0;">
                                <HBox alignment="CENTER_LEFT">
                                    <Label style="-fx-text-fill: #7f8c8d;" text="Total Amount:" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="totalLabel" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="0.00 $" />
                                </HBox>

                                <Button maxWidth="Infinity" onAction="#handlePlaceOrder" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 50; -fx-cursor: hand;" text="CONFIRM &amp; PAY" />

                                <Button maxWidth="Infinity" onAction="#handleClearCart" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" text="Clear Cart" />
                            </VBox>

                            <Text fill="#95a5a6" style="-fx-font-size: 11; -fx-font-style: italic;" text="Payment is deducted from your available balance." wrappingWidth="340" />
                        </VBox>
                    </HBox>
                </Tab>

                <!-- History Tab -->
                <Tab text="My Order History">
                    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f0f2f5;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 24px;" text="📜" />
                            <VBox>
                                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Recent Orders" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;" text="View your order details and items purchased below." />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleRefreshHistory" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="Refresh History" />
                        </HBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                            <!-- Column header placeholder to help user visualize the data structure -->
                            <HBox spacing="10" style="-fx-padding: 0 0 10 5;">
                                <Label prefWidth="120" style="-fx-font-weight: bold; -fx-text-fill: #95a5a6;" text="Order Date" />
                                <Label prefWidth="300" style="-fx-font-weight: bold; -fx-text-fill: #95a5a6;" text="Products Purchased" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #95a5a6;" text="Total Paid" />
                            </HBox>
                            <Separator />

                            <!--
                                historyListView will now host the data.
                                Note: In UserController.java, ensure the cell factory returns a layout
                                that includes the list of item names from the order object.
                            -->
                            <ListView fx:id="historyListView" style="-fx-background-color: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>
</AnchorPane>